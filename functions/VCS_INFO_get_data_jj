setopt localoptions NO_shwordsplit

local base=${vcs_comm[basedir]}
local action branch staged unstaged revision misc
local _is_working_copy _is_root _is_empty _bookmarks _bookmark_id _bookmark_name _parent_id _diff_status
local _track_ahead _track_behind

# --ignore-working-copy is safe here: bookmarks are persisted state
eval `${vcs_comm[cmd]} log --ignore-working-copy -n 1 --no-graph --color never \
  -r "coalesce(ancestors(present(@)) & bookmarks(), root())" \
  -T '
    separate(" ",
      "_bookmark_id=" ++ change_id,
      "_is_working_copy=" ++ current_working_copy,
      "_is_root=" ++ root,
      "branch=\"" ++ bookmarks.join(" ") ++ "\"",
      if(local_bookmarks.len() > 0, "_bookmark_name=\"" ++ local_bookmarks.first().name() ++ "\""),
    )
  '`

# No --ignore-working-copy: forces snapshot so @ reflects on-disk state
eval `${vcs_comm[cmd]} log -n 1 --no-graph --color never -r "@" \
  -T '
    separate(" ",
      "revision=\"" ++ change_id.shortest() ++ "\"",
      "_parent_id=\"" ++ parents.map(|c| c.change_id()).join("-") ++ "\"",
      if(empty, "", "unstaged=true"),
      if(conflict, "action=conflict"),
      if(!empty, "_diff_status=\"" ++ self.diff().files().map(|f| f.status_char()).join("") ++ "\"")
    )'`

if [[ $_is_working_copy == "false" && $_bookmark_id != $_parent_id ]]; then
  staged=true
fi

if [[ $_is_root == "true" ]]; then
  branch="root()"
fi

[[ $action == "conflict" ]] && action='⚡'

if [[ -n $_diff_status ]]; then
  local m=${#${_diff_status//[^M]/}}
  local a=${#${_diff_status//[^A]/}}
  local d=${#${_diff_status//[^D]/}}
  local r=${#${_diff_status//[^R]/}}
  local c=${#${_diff_status//[^C]/}}

  local changes=''
  (( m )) && changes+="M${m}"
  (( a )) && changes+="${changes:+|}A${a}"
  (( d )) && changes+="${changes:+|}D${d}"
  (( r )) && changes+="${changes:+|}R${r}"
  (( c )) && changes+="${changes:+|}C${c}"
  [[ -n $changes ]] && misc="[${changes}]"
fi

if [[ $_is_root == "false" && -n $_bookmark_id ]]; then
  local local_ahead
  local_ahead=$(${vcs_comm[cmd]} log --ignore-working-copy \
    -r "${_bookmark_id}..@ ~ empty()" --count 2>/dev/null)
  local_ahead=${local_ahead//[[:space:]]/}
  (( local_ahead > 0 )) && misc+="${misc:+ }↑${local_ahead}"

  if [[ -n $_bookmark_name ]]; then
    # remote_bookmarks() (the revset function) excludes the colocated @git
    # pseudo-remote by default, so this resolves to wherever the real
    # tracked remote(s) point — which, once diverged, is a different
    # commit than $_bookmark_id. self.remote_bookmarks() (the per-commit
    # template method) is then unambiguous at that commit.
    eval `${vcs_comm[cmd]} log --ignore-working-copy -n 1 --no-graph --color never \
      -r "remote_bookmarks(exact:\"${_bookmark_name}\")" \
      -T '
        separate(" ",
          "_track_ahead=" ++ self.remote_bookmarks().first().tracking_ahead_count().lower(),
          "_track_behind=" ++ self.remote_bookmarks().first().tracking_behind_count().lower()
        )'`

    local tracking=''
    (( _track_behind > 0 )) && tracking+="⇡${_track_behind}"
    (( _track_ahead > 0 ))  && tracking+="⇣${_track_ahead}"
    [[ -n $tracking ]] && misc+="${misc:+ }${tracking}"
  fi
fi

VCS_INFO_formats "${action}" "${branch}" "${base}" "${staged}" "${unstaged}" "${revision}" "${misc}"
